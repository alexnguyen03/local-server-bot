# bot env (systemd EnvironmentFile for the deploy-bot service). Do NOT commit the real file.
BOT_TOKEN=
ALLOWED_CHAT_ID=
ALLOWED_THREAD_ID=       # if the group uses topics
ALLOWED_USER_IDS=        # user ids, comma-separated
CI_BOT_IDS=              # id of the CI bot, if any (the number before ':' in its token)
OPEN_READONLY=0
AUTO_INTERVAL=120
AUTO_DEPLOY=              # empty = follow "auto": true in ops/structure.json. Fill in here to override without reinstalling.
NET_DEAD_SECONDS=900
