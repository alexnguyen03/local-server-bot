#!/usr/bin/env bash
# lsb <command> [...]   Convenience wrapper around this install's scripts. Usable from anywhere once
# it's on PATH (ops/install.sh symlinks it into /usr/local/bin).
#   lsb install                         re-fetch the latest release and re-run the installer
#   lsb deploy <env> <component> ...    same as calling deploy directly
#   lsb status [env]                    same as deploy-bot status
#   lsb doctor [env]                    same as deploy-bot doctor
#   lsb help
set -euo pipefail

ROOT="${DEVOPS_ROOT:-/devops}"
SRC="${LSB_SRC:-/devops/_src}"
REPO="${LSB_REPO:-alexnguyen03/local-server-bot}"

usage() { sed -n '2,7p' "$0" | sed 's/^# \{0,1\}//'; exit 64; }

cmd="${1:-help}"; shift || true

case "$cmd" in
  install)
    url="https://github.com/$REPO/releases/latest/download/local-server-bot.tar.gz"
    tmp="$(mktemp -d)"; trap 'rm -rf "$tmp"' EXIT
    echo ">> Downloading $url"
    curl -fsSL "$url" -o "$tmp/pkg.tar.gz"
    # No rm -rf: ops/install.conf and ops/structure.json live under $SRC but are gitignored, so
    # they're never in the tarball — extracting over the directory updates the code without
    # touching them (see install.sh at the repo root for the same reasoning).
    mkdir -p "$SRC"
    tar xzf "$tmp/pkg.tar.gz" -C "$SRC"
    exec bash "$SRC/ops/install.sh"
    ;;
  deploy)  exec "$ROOT/bin/deploy" "$@" ;;
  status)  exec "$ROOT/bin/deploy-bot" status "$@" ;;
  doctor)  exec "$ROOT/bin/deploy-bot" doctor "$@" ;;
  help|-h|--help|"") usage ;;
  *) echo "lsb: no such command: $cmd (run 'lsb help')" >&2; exit 64 ;;
esac
